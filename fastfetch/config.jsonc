{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "display": {
        "separator": " "
    },
"modules": [
        {
            "key": " {#30} user   {#keys}",
            "type": "title",
            "format": "{#32}{user-name}"
        },
        {
            "key": " {#30}󰇅 host   {#keys}",
            "type": "title",
            "format": "{#32}{host-name}"
        },
        {
            "key": " {#30}{icon} uptime {#keys}",
            "type": "uptime"
        },
        {
            "key": " {#30}{icon} distro {#keys}",
            "type": "os",
			"format": "{name}"
        },
        {
            "key": " {#30}{icon} kernel {#keys}",
            "type": "kernel",
			"format": "{release}"

        },
        {
            "key": " {#30}{icon} desktop{#keys}",
            "type": "wm"
        },
        {
            "key": " {#30}{icon} term   {#keys}",
            "type": "terminal"
        },
        {
            "key": " {#30}{icon} shell  {#keys}",
            "type": "shell"
        },
        {
            "key": " {#30}{icon} cpu    {#keys}",
            "type": "cpu",
			"format": "{name}"
        },
        {
            "key": " {#30}{icon} gpu    {#keys}",
            "type": "gpu"
        },
        {
            "key": " {#30}{icon} disk   {#keys}",
            "type": "disk",
			"format": "{size-used} / {size-total}",
            "folders": "/"
        },

		"break"
    ],
"logo": {
    "source": "/home/portbound/.config/fastfetch/frog.txt",
	"color": { "1": "black"}
}
}
