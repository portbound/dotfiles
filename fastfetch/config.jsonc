{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "display": {
        "separator": " "
    },
"modules": [
        {
            "key": " {#32} user   {#keys}",
            "type": "title",
            "format": "{#34}{user-name}"
        },
        {
            "key": " {#32}󰇅 host   {#keys}",
            "type": "title",
            "format": "{#34}{host-name}"
        },
        {
            "key": " {#32}{icon} uptime {#keys}",
            "type": "uptime"
        },
        {
            "key": " {#32}{icon} distro {#keys}",
            "type": "os",
			"format": "{name}"
        },
        {
            "key": " {#32}{icon} kernel {#keys}",
            "type": "kernel",
			"format": "{release}"

        },
        {
            "key": " {#32}{icon} desktop{#keys}",
            "type": "wm"
        },
        {
            "key": " {#32}{icon} term   {#keys}",
            "type": "terminal"
        },
        {
            "key": " {#32}{icon} shell  {#keys}",
            "type": "shell"
        },
        {
            "key": " {#32}{icon} cpu    {#keys}",
            "type": "cpu",
			"format": "{name}"
        },
        {
            "key": " {#32}{icon} gpu    {#keys}",
            "type": "gpu"
        },
        {
            "key": " {#32}{icon} disk   {#keys}",
            "type": "disk",
			"format": "{size-used} / {size-total}",
            "folders": "/"
        }
    ],
"logo": {
    "source": "/home/portbound/.config/fastfetch/bork.txt"
}
}
