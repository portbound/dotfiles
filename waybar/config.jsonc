// -*- mode: jsonc -*-
{
    "layer": "top", 
    "position": "top",
    "spacing": 4, 
    // "width": 2780,
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        // "custom/notes",
        // "custom/battery-mode",
        "bluetooth",
        "pulseaudio",
        "network",
        "battery",
        "custom/power"
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "format": "{name}",
        "persistent-workspaces": {
            "*": [1, 2, 3, 4]
        }
    },

    "hyprland/window": { 
		"format":"{initialTitle}",
        "max-length": 40,
		"icon": true,
        "separate-outputs": false,
        "tooltip": false,
		"rewrite": {
				"(.*) - Google Chrome": "Chrome",
				"Loading...": "Files",
				"Spotify Premium": " Spotify"
		}
    },
    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "clock": {
        "format": "{:%a, %b %d	%I:%M %p}",        
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "timezone": "America/New_York",
    },
    "battery": {
        "states": {
            "good": 70,
            "warning": 40,
            "critical": 20
        },
        "format": "{icon} [ {capacity}% ]",
        "format-charging": " [ {capacity}% ]",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
				"tooltip": false,
	    "tooltip-format": "{capacity}"
    },
    "custom/battery-mode": {
        "format": "  ",
        "on-click": "ghostty -e ~/scripts/toggle_conservation_mode.sh",
        "tooltip": false
    },
    "network": {
        "format-wifi": "	[ {essid} ]",
        "format-ethernet": "󰈀",
        "format-disconnected": "",
        "tooltip": false,
        "on-click": "ghostty -e nmtui"
    },
    "bluetooth": {
        "format": "   [ {num_connections} ]",
        "on-click": "ghostty -e bluetui"
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{icon}	[ {volume}% ]",
        "format-bluetooth": "{format_source}  {volume}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "",
            "headset": "",
            "default": ""
        },
        "on-click": "pavucontrol"
    },
    "custom/mic": {
        "format": "",
        "format-source": "",
        "format-source-muted": " ",
        "on-click": "pavucontrol"
    },
    "custom/power": {
        "format" : " ⏻ ",
		"tooltip": false,
		"on-click": "$HOME/.config/dotfiles/waybar/power-menu.sh"
    },
    "custom/notes": {
        "format": " 󰏫 ",
        	"tooltip": false,
                "on-click": "ghostty -e nvim ~/Documents/Notes/scratchpad.md"
    }
}
