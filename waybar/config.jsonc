// -*- mode: jsonc -*-
{
    "layer": "top", 
    "position": "top",
    "spacing": 4, 
    // "width": 2780,
    "modules-left": [
		"custom/logo",
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "bluetooth",
        "network",
        "pulseaudio",
		"power-profiles-daemon",
        "battery",
		"custom/conservation-mode",
        "custom/power"
    ],

    "custom/logo": {
		"format": "  ", 
    	"tooltip": false,
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "format": "{name}",
        "persistent-workspaces": {
            "*": [1, 2, 3, 4]
        }
    },

		  "hyprland/window": { 
		"format":"{initialTitle}",
		      "max-length": 40,
		"icon": true,
		      "separate-outputs": false,
		      "tooltip": false,
		"rewrite": {
				"(.*) - Google Chrome": "Chrome",
				"Loading...": "Files",
				"Spotify Premium": " Spotify"
		}
		  },
    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "clock": {
        // "format": "{:%a, %b %d	%I:%M %p}",        
        "format": "{:%I:%M %p}",        
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "timezone": "America/New_York",
    },
    "battery": {
        "states": {
            "good": 70,
            "warning": 40,
            "critical": 20
        },
        "format": "{icon} [ {capacity}% ]",
        "format-charging": " [ {capacity}% ]",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
				"tooltip": false,
	    "tooltip-format": "{capacity}"
    },
"custom/conservation-mode": {
    "format": "{icon}",
    "return-type": "json",
    "interval": 30,
    "exec": "~/scripts/toggle_conservation_mode.sh",
    "on-click": "sudo ~/scripts/toggle_conservation_mode.sh --toggle",
    "format-icons": {
        "on": " 󰔡 ", 
        "off": " 󰔢 "
    },
    "tooltip": false
},
    "network": {
        "interface": "wlan0",
		"format-wifi": "	[ {signalStrength}% ]",
        "format-ethernet": "󰈀",
        "format-disconnected": "",
        "tooltip": false,
        "on-click": "ghostty -e impala"
    },
    "bluetooth": {
        "format": "   [ {num_connections} ]",
        "on-click": "ghostty -e bluetui"
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{icon}	[ {volume}% ]",
        "format-bluetooth": "{format_source}  {volume}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": "󰝟 [ 0% ]",
        "format-icons": {
            "headphone": "",
            "headset": "",
            "default": ""
        },
        "on-click": "pavucontrol"
    },
    "custom/mic": {
        "format": "",
        "format-source": "",
        "format-source-muted": " ",
        "on-click": "pavucontrol"
    },
    "custom/power": {
        "format" : " ⏻ ",
		"tooltip": false,
		"on-click": "$HOME/.config/dotfiles/waybar/power-menu.sh"
    },
    "custom/notes": {
        "format": " 󰏫 ",
        	"tooltip": false,
                "on-click": "ghostty -e nvim ~/Documents/Notes/scratchpad.md"
    },
"power-profiles-daemon": {
  "format": "{icon}",
  "tooltip": true,
  "format-icons": {
    "performance": " 󰓅 ",
    "balanced": " 󰾅 ",
    "power-saver": " 󰾆 "
  }
}
}
